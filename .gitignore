# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# cloudflare / wrangler local dev state (local D1 SQLite, dev cache) —
# never contains anything meant to be shared, never commit it
.wrangler/
.dev.vars
.dev.vars.*

# private Studio D1 exports — these can contain draft/editorial content
# and must stay outside Git. Keep long-term copies in private storage.
.studio-backups/

# generated Studio published-content recovery seed. The public JSON in Git
# is the source of truth; regenerate this immediately before using it.
/migrations/0002_seed_published_posts.sql

# typescript
*.tsbuildinfo
next-env.d.ts
