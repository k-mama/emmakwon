<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EMMA TRANSCRIBER"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#111827" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="영상은 휴대폰에 그대로 둡니다.\n여러 개를 골라두면 순서대로 대본을 만듭니다."
            android:textSize="16sp"
            android:textColor="#4B5563"
            android:lineSpacingExtra="3dp" />

        <Button
            android:id="@+id/selectButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:text="영상 검색 · 여러 개 선택"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:enabled="false"
            android:text="선택한 파일 순차 처리 시작"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/fileInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:padding="16dp"
            android:background="#F8FAFC"
            android:text="아직 선택한 영상이 없습니다."
            android:textSize="15sp"
            android:textColor="#374151"
            android:lineSpacingExtra="2dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="24dp"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="준비됨"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#111827" />

        <TextView
            android:id="@+id/detailText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="파일 선택 화면의 검색을 이용할 수 있습니다. 첫 사용 때 Whisper 모델 약 142MB를 한 번만 내려받습니다."
            android:textSize="13sp"
            android:textColor="#6B7280"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:id="@+id/outputText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:padding="16dp"
            android:background="#F3F4F6"
            android:text="완료될 때마다 T001.txt 같은 짧은 파일명과 저장 위치가 여기에 표시됩니다."
            android:textSize="14sp"
            android:textColor="#374151"
            android:lineSpacingExtra="2dp" />

    </LinearLayout>
</ScrollView>
