<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EMMA TRANSCRIBER"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#111827" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="영상은 휴대폰에 그대로 둡니다.\n대본만 추출해서 TXT 파일로 저장합니다."
            android:textSize="16sp"
            android:textColor="#4B5563"
            android:lineSpacingExtra="3dp" />

        <Button
            android:id="@+id/selectButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:text="영상 선택하고 대본 추출"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/fileInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="아직 선택한 영상이 없습니다."
            android:textSize="15sp"
            android:textColor="#374151" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="24dp"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="준비됨"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#111827" />

        <TextView
            android:id="@+id/detailText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="첫 사용 때 다국어 Whisper 모델 약 142MB를 한 번만 내려받습니다. 이후 음성과 대본은 기기 안에서 처리됩니다."
            android:textSize="13sp"
            android:textColor="#6B7280"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:id="@+id/outputText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:padding="16dp"
            android:background="#F3F4F6"
            android:text="완료되면 저장 위치가 여기에 표시됩니다."
            android:textSize="14sp"
            android:textColor="#374151" />

    </LinearLayout>
</ScrollView>
